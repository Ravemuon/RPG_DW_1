# ------------------------------
#  Configurações de atributos do Git
# ------------------------------

# Força linha final LF para arquivos de texto (evita conflitos no Windows)
* text=auto eol=lf

# Arquivos que devem ser tratados como binários (não devem ser modificados automaticamente)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.rar binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.sqlite binary

# Arquivos específicos com diff personalizado
*.php diff=php
*.blade.php diff=html
*.js diff=javascript
*.css diff=css
*.json diff=json

# Definir linguagem para o GitHub (exibe corretamente)
*.blade.php linguagem=PHP